{
  "name": "pi-workflow",
  "displayName": "Pi Workflow",
  "description": "Visual companion for pi coding agent workflows",
  "version": "0.1.0",
  "publisher": "pi-workflow",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pi-workflow",
          "title": "Pi Workflow",
          "icon": "media/pi-icon.svg"
        }
      ]
    },
    "views": {
      "pi-workflow": [
        {
          "id": "pi.status",
          "name": "Workflow Status"
        },
        {
          "id": "pi.todos",
          "name": "TODOs"
        },
        {
          "id": "pi.files",
          "name": "Changed Files"
        },
        {
          "id": "pi.chat",
          "type": "webview",
          "name": "Pi Chat"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pi.status",
        "contents": "No active workflow detected.\n\nStart a workflow with pi:\n[Open Terminal](command:workbench.action.terminal.new)\n\nThen run: /workflow Your task",
        "when": "!pi.hasActiveWorkflow"
      }
    ],
    "commands": [
      {
        "command": "pi.openPlan",
        "title": "Pi: Open Plan"
      },
      {
        "command": "pi.openVerification",
        "title": "Pi: Verification Results"
      },
      {
        "command": "pi.showDiff",
        "title": "Pi: Show Changes"
      },
      {
        "command": "pi.refresh",
        "title": "Pi: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "pi.startChat",
        "title": "Pi: Start Chat"
      },
      {
        "command": "pi.stopChat",
        "title": "Pi: Stop Chat"
      },
      {
        "command": "pi.newSession",
        "title": "Pi: New Session",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pi.newSession",
          "when": "view == pi.chat",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Pi Workflow",
      "properties": {
        "pi-workflow.piPath": {
          "type": "string",
          "default": "pi",
          "scope": "machine",
          "description": "Path to the pi binary"
        },
        "pi-workflow.defaultProvider": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Default LLM provider (e.g. anthropic, openai)"
        },
        "pi-workflow.defaultModel": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Default model ID"
        },
        "pi-workflow.extraArgs": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "scope": "machine",
          "description": "Extra arguments passed to pi"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
